# Deployed Google Apps Script web app endpoint that appends a row to the leads Sheet
SHEETS_WEBHOOK_URL=

# Shared secret sent with every Sheet write; the Apps Script rejects requests without it
SHEETS_SHARED_SECRET=

# Destination number for the wa.me prefill link (digits with country code, e.g. 919000000000)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google reviews section (optional — the section renders nothing without these).
# API key from Google Cloud with "Places API (New)" enabled:
GOOGLE_PLACES_API_KEY=
# The shop's Place ID, from the Google Business Profile / Place ID finder:
GOOGLE_PLACE_ID=
